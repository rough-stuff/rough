 ],
 "sentences": [
  {
   "text": "一百块从公司出发。",
   "start": 0,
   "end": 1.905,
   "unit_range": [
    0,
    8
   ]
  },
  {
   "text": "先交给政府，再发到你手里，你又花回公司。",
   "start": 2.455,
   "end": 6.942,
   "unit_range": [
    8,
    25
   ]
  },
  {
   "text": "转了一圈，公司多赚了零。",
   "start": 7.492,
   "end": 10.093,
   "unit_range": [
    25,
    35
   ]
  },
  {
   "text": "同一份钱，放在今天很便宜。",
   "start": 10.643,
   "end": 13.482,
   "unit_range": [
    35,
    46
   ]
  },
  {
   "text": "等到工资没了，就贵了三倍。",
   "start": 14.032,
   "end": 16.871,
   "unit_range": [
    46,
    57
   ]
  },
  {
   "text": "机器造出货。",
   "start": 17.421,
   "end": 18.612,
   "unit_range": [
    57,
    62
   ]
  },
  {
   "text": "货要有人买。",
   "start": 19.162,
   "end": 20.352,
   "unit_range": [
    62,
    67
   ]
  },
  {
   "text": "买要有工资。",
   "start": 20.902,
   "end": 22.093,
   "unit_range": [
    67,
    72
   ]
  },
  {
   "text": "工资没了，这条链就断了。",
   "start": 22.643,
   "end": 25.244,
   "unit_range": [
    72,
    82
   ]
  },
  {
   "text": "按公式该发三千八。",
   "start": 25.794,
   "end": 27.699,
   "unit_range": [
    82,
    90
   ]
  },
  {
   "text": "最后只批了一千二。",
   "start": 28.249,
   "end": 30.153,
   "unit_range": [
    90,
    98
   ]
  },
  {
   "text": "一刀砍掉将近七成。",
   "start": 30.703,
   "end": 32.608,
   "unit_range": [
    98,
    106
   ]
  },
  {
   "text": "一九四七年是六十五。",
   "start": 33.158,
   "end": 35.301,
   "unit_range": [
    106,
    115
   ]
  },
  {
   "text": "两千年还有六十。",
   "start": 35.851,
   "end": 37.518,
   "unit_range": [
    115,
    122
   ]
  },
  {
   "text": "之后一路往下。",
   "start": 38.068,
   "end": 39.496,
   "unit_range": [
    122,
    128
   ]
  },
  {
   "text": "现在只剩五十三，有记录以来最低。",
   "start": 40.046,
   "end": 43.6,
   "unit_range": [
    128,
    142
   ]
  },
  {
   "text": "七十多年前，福特上了机器。",
   "start": 44.15,
   "end": 46.989,
   "unit_range": [
    142,
    153
   ]
  },
  {
   "text": "一九八二年，阿拉斯加开始分钱。",
   "start": 47.539,
   "end": 50.854,
   "unit_range": [
    153,
    166
   ]
  },
  {
   "text": "今天，轮到机房了。",
   "start": 51.404,
   "end": 53.29,
   "unit_range": [
    166,
    173
   ]
  },
  {
   "text": "很多人觉得，以后有人养。",
   "start": 53.84,
   "end": 56.441,
   "unit_range": [
    173,
    183
   ]
  },
  {
   "text": "可是凭什么呢？",
   "start": 56.991,
   "end": 58.42,
   "unit_range": [
    183,
    189
   ]
  },
  {
   "text": "老板挣到的，就等于老板们自己花出去的。",
   "start": 58.97,
   "end": 63.238,
   "unit_range": [
    189,
    206
   ]
  },
  {
   "text": "每产出一百块。",
   "start": 63.788,
   "end": 65.216,
   "unit_range": [
    206,
    212
   ]
  },
  {
   "text": "工资拿走五十三。",
   "start": 65.766,
   "end": 67.433,
   "unit_range": [
    212,
    219
   ]
  },
  {
   "text": "剩下的归资本。",
   "start": 67.983,
   "end": 69.411,
   "unit_range": [
    219,
    225
   ]
  },
  {
   "text": "老板提着钱走了。",
   "start": 69.961,
   "end": 71.628,
   "unit_range": [
    225,
    232
   ]
  }
 ]
}